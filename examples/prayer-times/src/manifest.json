{
  "package": "de.halle.gebetszeiten",
  "name": "Gebetszeiten",
  "versionName": "0.2.1",
  "versionCode": 3,
  "minPlatformVersion": 1000,
  "minAPILevel": 1,
  "icon": "/common/icon.png",
  "deviceTypeList": ["watch"],
  "features": [{ "name": "system.router" }],
  "config": { "logLevel": "warn", "designWidth": 212 },
  "display": { "backgroundColor": "#000000" },
  "router": {
    "entry": "pages/index",
    "pages": {
      "pages/index": { "component": "index" },
      "pages/info": { "component": "info" }
    },
    "widgets": {
      "widgets/next": {
        "type": "js",
        "name": "Nächstes Gebet",
        "description": "Gebetszeiten und Countdown für Halle (Saale)",
        "component": "index",
        "minCardPlatformVersion": 1,
        "versionCode": 3,
        "versionName": "0.2.1",
        "targetManufacturers": ["xiaomi"],
        "sizes": ["FULLxFULL"],
        "deviceTypeList": ["watch"],
        "previewImages": [{
          "size": "FULLxFULL",
          "images": ["/widgets/next/assets/preview.png"]
        }]
      }
    }
  }
}
